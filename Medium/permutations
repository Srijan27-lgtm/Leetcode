class Solution {
public:
 void backtrack(vector<int>& nums , vector<int> & curr , vector<bool>& vis , vector<vector<int>>& result) {
    if(curr.size() == nums.size()) {
        result.push_back(curr);
        return;
    }
    for (int i = 0; i < nums.size(); i++) {
     if (vis[i] == true) {
        continue;
     }
     else { vis[i] = true;
     curr.push_back(nums[i]);
     backtrack(nums , curr , vis , result);
     curr.pop_back();
     vis[i] = false; 

     }
    }

 }
    vector<vector<int>> permute(vector<int>& nums) {
        vector<vector<int>> result;
        vector<int> curr;
        vector<bool> vis(nums.size() , false);
        backtrack(nums , curr , vis , result);
        return result;

    }
};
